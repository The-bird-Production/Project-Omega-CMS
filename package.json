{
  "name": "omega-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Project Omega CMS monorepo (pnpm workspace)",
  "license": "MIT",
  "scripts": {
    "dev:api": "pnpm --filter @omega/api dev",
    "dev:web": "pnpm --filter @omega/web dev",
    "build": "pnpm --filter @omega/web run build",
    "test": "pnpm --filter @omega/api test",
    "typecheck": "pnpm --filter @omega/api run typecheck",
    "lint": "pnpm --filter @omega/web lint"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0"
}
