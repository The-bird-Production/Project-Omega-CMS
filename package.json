{
  "name": "omega-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Project Omega CMS monorepo (pnpm workspace)",
  "license": "MIT",
  "scripts": {
    "dev:api": "pnpm --filter @omega/api dev",
    "dev:web": "pnpm --filter @omega/web dev",
    "build": "pnpm --filter @omega/db build && pnpm -r --filter=!@omega/db build",
    "test": "pnpm --filter @omega/api test",
    "lint": "pnpm --filter @omega/web lint"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.24.0"
}
