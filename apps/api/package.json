{
  "name": "@omega/api",
  "version": "1.0.0",
  "description": "Backend For project Omega",
  "license": "ISC",
  "author": "Faynix - The bird production",
  "type": "module",
  "main": "server.js",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "start": "tsx server.js",
    "dev": "tsx watch server.js",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.js --passWithNoTests",
    "test:setup": "dotenv -e .env.test -- pnpm --filter @omega/db run migrate:reset && dotenv -e .env.test -- pnpm --filter @omega/db run db:push",
    "test:watch": "npm run test -- --watch",
    "migrate:content-to-blocks": "node scripts/migrate-content-to-blocks.mjs",
    "manage-users": "tsx scripts/manage-users.mts"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/server-util": "^0.55.0",
    "@omega/db": "workspace:*",
    "abbrev": "^5.0.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.7.9",
    "better-auth": "^1.7.5",
    "cjstoesm": "^3.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "cuid": "^3.0.0",
    "dotenv": "^18.0.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "sanitize-filename": "^1.6.3",
    "socket.io": "^4.8.3",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
