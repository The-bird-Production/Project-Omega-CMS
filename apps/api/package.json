{
  "name": "@omega/api",
  "version": "1.0.0",
  "description": "Backend For project Omega",
  "license": "ISC",
  "author": "Faynix - The bird production",
  "type": "module",
  "main": "server.js",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "start": "tsx server.js",
    "dev": "tsx watch server.js",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --config=jest.config.js --passWithNoTests",
    "test:setup": "dotenv -e .env.test -- pnpm --filter @omega/db run migrate:reset && dotenv -e .env.test -- pnpm --filter @omega/db run db:push",
    "test:watch": "npm run test -- --watch"
  },
  "dependencies": {
    "@omega/db": "workspace:*",
    "abbrev": "^3.0.1",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "better-auth": "^1.3.7",
    "cjstoesm": "^3.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cuid": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cron": "^4.6.0",
    "sanitize-filename": "^1.6.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
