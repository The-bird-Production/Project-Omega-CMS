
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String?   @db.Text
  email         String
  emailVerified Boolean
  image         String?   @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  role       String?   @db.Text
  banned     Boolean?
  banReason  String?   @db.Text
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @db.Text

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
model file {
  id        Int      @id @default(autoincrement())
  name      String   @unique(map: "File_name_key")
  filename  String   @unique(map: "File_filename_key")
  slug      String   @unique(map: "File_slug_key")
  createdAt DateTime @default(now())
}

model image {
  id        Int      @id @default(autoincrement())
  title     String
  alt       String
  file      String   @unique(map: "Image_file_key")
  slug      String   @unique(map: "Image_slug_key")
  createdAt DateTime @default(now())
}

model log {
  id     Int      @id @default(autoincrement())
  action String
  color  String
  user   String
  date   DateTime @default(now())
}

// `template` names a custom page template a theme provides (see
// apps/web/lib/pageTemplates/README.md) — null renders the page's blocks
// normally. Themes register templates the same way plugins register
// blocks: a discoverable client-side contribution point, not something
// this table validates against (a theme can be uninstalled later; the
// public route falls back to the normal block rendering if the named
// template is no longer available).
// locale + a compound (slug, locale) unique, not a global slug unique, so
// the same slug can have a French and an English row side by side — each
// is its own independently-written page (manual translation, no
// machine-translation pipeline), matching how next-intl's routing
// resolves a locale-prefixed URL to the same slug in a different locale.
// Existing rows default to "fr" so current content keeps working as-is.
model page {
  id        Int      @id @default(autoincrement())
  slug      String
  locale    String   @default("fr")
  title     String
  body      String   @db.Text
  template  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale], map: "Page_slug_locale_key")
}

model redirect {
  id        Int      @id @default(autoincrement())
  from      String   @unique(map: "Redirect_from_key")
  to        String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A navigation link, grouped by `menu` (e.g. "main" for the header,
// "footer" for the footer) so a theme's Header/Footer components can each
// fetch just their own list via GET /menu/:menu. `order` controls display
// order within that menu; ties are broken by id (creation order).
// Optional one level of nesting (parentId) for a dropdown-style submenu —
// deliberately not deeper: a real second level covers every self-hosted
// site this CMS has been used for so far, and a generic infinitely-nested
// tree is more UI (and admin complexity) than that's worth.
// locale: each language gets its own full set of rows (same reasoning as
// page's own locale field) rather than a single shared tree with
// per-field translations — a menu is small enough that admin duplication
// across languages is cheap, and this keeps every content type's
// multilingual story (duplicate-and-translate the whole row) consistent.
model menuItem {
  id        Int        @id @default(autoincrement())
  menu      String     @default("main")
  locale    String     @default("fr")
  label     String
  url       String
  target    String?
  order     Int        @default(0)
  parentId  Int?
  parent    menuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  menuItem[] @relation("MenuItemChildren")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([menu])
  @@index([parentId])
  @@index([locale])
}


// One row per API request (previously one row per request but holding
// process-lifetime CUMULATIVE counters — every stored row duplicated the
// previous one plus a bit more, so date-range queries returned meaningless
// ever-growing snapshots instead of per-period figures). Real per-request
// values now, aggregated on demand by GetStatsController.
model stats_api {
  id           Int      @id @default(autoincrement())
  method       String
  path         String
  statusCode   Int
  responseTime Float // ms
  responseSize Int // bytes
  date         DateTime @default(now())

  @@index([date])
}

// One row per page view. `page` used to receive a hardcoded generic label
// ("ArticleList", "ArticleDetail", ...) for most routes instead of the
// actual URL, making every article's views indistinguishable from every
// other's — MainLayout.js now sends the real pathname.
//
// visitorId is a random id from a first-party cookie the browser sets
// itself (lib/analytics.js) — never derived from the IP address, so this
// stays anonymous. Session duration/bounce rate aren't stored columns:
// they're derived by grouping a visitor's rows into sessions (a gap of
// 30+ minutes starts a new one) at query time in GetAudience.
model stats_web {
  id        Int      @id @default(autoincrement())
  count     Int      @default(1)
  page      String
  date      DateTime @default(now())
  visitorId String?
  referrer  String?
  device    String?
  browser   String?

  @@index([date])
  @@index([page])
  @@index([visitorId])
}

// locale: same reasoning as page's own locale field — a translated
// article is its own independently-written row, not a shared row with
// per-field translations.
model article {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String
  locale      String   @default("fr")
  body        String   @db.Text
  image       String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime
  category    String?
  // Comma-separated tag list (e.g. "news,tech") — MySQL has no native
  // scalar list type, and a join table is more normalization than this
  // CMS's search/filter feature needs.
  tags        String?

  @@unique([slug, locale], map: "Article_slug_locale_key")
  @@unique([title, locale], map: "Article_title_locale_key")
  @@index([category])
}

model articleSaved {
  id          Int      @id @default(autoincrement())
  draftId     String?   @unique()
  title       String?
  slug        String?
  body        String?   @db.Text
  image       String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

}

// Singleton row (id always 1) holding this instance's auto-update preferences.
// Written/read by the update checker introduced in a later phase; the schema
// lands now so the admin UI and updater can be built against a stable shape.
model AppSettings {
  id                Int       @id @default(1)
  autoUpdateEnabled Boolean   @default(false)
  updateChannel     String    @default("stable")
  lastCheckedAt     DateTime?
  lastVersionSeen   String?
  updatedAt         DateTime  @updatedAt
}

// Tracks installed plugins so the admin dashboard / updater can tell what's
// out of date without re-reading every plugin.json off disk. Populated by
// InstallPlugins on install/update; the plugin.json manifest on disk stays
// the source of truth for what actually gets loaded at runtime.
model Plugin {
  id          Int      @id @default(autoincrement())
  pluginId    String   @unique
  name        String
  version     String
  source      String?
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Same as Plugin, for installed themes.
model Theme {
  id          Int      @id @default(autoincrement())
  themeId     String   @unique
  name        String
  version     String
  source      String?
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}