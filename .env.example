# Copy this file to .env before running `docker compose up` (either the
# official docker-compose.yml or with docker-compose.dev.yml layered on top).
# docker compose reads .env from the same directory automatically.

# --- Required: no safe default, docker-compose refuses to start without these ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Optional: sensible defaults for a single-machine local setup ---
# Public URL(s) allowed to call the API / open sessions (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000
# Backend URL the browser will call — baked into the client at container
# startup (see apps/web/docker-entrypoint.sh), so this can differ per
# deployment without rebuilding the image.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Public URL of the site itself (no trailing slash) — used for the
# generated sitemap.xml/robots.txt and canonical/Open Graph URLs. Same
# runtime-substitution mechanism as NEXT_PUBLIC_BACKEND_URL above.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# How often (seconds) Watchtower checks GHCR for a new image, if you've
# opted in with `docker compose --profile watchtower up -d`.
WATCHTOWER_POLL_INTERVAL=300
# URL the API container uses to reach the client container directly (not
# through the browser) to tell it a page changed, so the public site
# reflects an edit immediately instead of waiting up to 60s. Leave unset to
# just keep that 60s delay instead. The default below is the client's
# Compose service name, reachable on the internal Docker network.
WEB_URL=http://omega-client:3000
# Shared secret so only the API can trigger that revalidation. Optional —
# if left blank, revalidation still works, just unauthenticated.
# Generate one with: openssl rand -base64 32
REVALIDATE_SECRET=
